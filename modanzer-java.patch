diff --git a/windows/src/main/java/com/napatc1/modanzer/Cheats.java b/windows/src/main/java/com/napatc1/modanzer/Cheats.java
new file mode 100644
index 0000000..c8a1713
--- /dev/null
+++ b/windows/src/main/java/com/napatc1/modanzer/Cheats.java
@@ -0,0 +1,187 @@
+package com.napatc1.modanzer;
+
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+import java.util.TreeSet;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+import java.util.stream.Collectors;
+import java.util.zip.ZipEntry;
+import java.util.zip.ZipInputStream;
+
+/** Cheat names, and the search through a jar for them. */
+final class Cheats {
+    private Cheats() {}
+
+    /** Strong names: unusual words that are basically only used by cheats. Matched case-sensitively anywhere. */
+    static final String[] STRONG = {
+        "AnchorTweaks", "AutoAnchor", "AutoCrystal", "AutoDoubleHand", "AutoHitCrystal",
+        "AutoPot", "AutoTotem", "InventoryTotem", "JumpReset", "LegitTotem", "PingSpoof",
+        "SelfDestruct", "ShieldBreaker", "TriggerBot", "AxeSpam", "WebMacro",
+        "KillAura", "CrystalAura", "AnchorAura", "AutoClicker"
+    };
+
+    /**
+     * Weak names: also ordinary game-code words (getVelocity, renderHitboxes...). They only count when they
+     * are a whole name on their own: a class called Velocity.class / VelocityModule.class, or the exact text
+     * "Velocity" stored as its own string in a class file.
+     */
+    static final String[] WEAK = { "Velocity", "Hitboxes", "AimAssist", "AutoArmor", "FastPlace" };
+
+    private static String alt(String[] names) {
+        return Arrays.stream(names).map(Pattern::quote).collect(Collectors.joining("|"));
+    }
+
+    static final Pattern STRONG_RE = Pattern.compile(alt(STRONG));
+    /** A class named exactly like a cheat module, e.g. AutoTotem or TriggerBotModule. */
+    static final Pattern CLASS_RE = Pattern.compile("^(?:" + alt(STRONG) + ")(?:Module|Hack|Feature|Mod)?$");
+    static final Pattern WEAK_NAME_RE = Pattern.compile("(?:^|/)(" + alt(WEAK) + ")(?:Module|Hack|Feature|Mod)?(?:\\$[^/]*)?\\.class$");
+    /** CONSTANT_Utf8 entry in a class file: tag 0x01, 2-byte length, then the text. */
+    static final Pattern WEAK_CONST_RE;
+    static {
+        StringBuilder sb = new StringBuilder("\u0001\u0000(?:");
+        for (int i = 0; i < WEAK.length; i++) {
+            if (i > 0) sb.append('|');
+            sb.append(Pattern.quote(String.valueOf((char) WEAK[i].length()) + WEAK[i]));
+        }
+        sb.append(")(?![\\w])");
+        WEAK_CONST_RE = Pattern.compile(sb.toString());
+    }
+
+    /** A known mod whose name says what it does counts as a cheat. */
+    static final Pattern FLAGGED_NAME_RE = Pattern.compile(
+        "(?ix) \\bmacros?\\b | auto[\\s_-]?(totem|crystal|anchor|pot|clicker|click|hit|double[\\s_-]?hand|shield[\\s_-]?break)"
+        + " | trigger[\\s_-]?bot | (crystal|anchor|kill)[\\s_-]?aura | aim[\\s_-]?(assist|bot|lock)"
+        + " | (inventory|legit|hover)[\\s_-]?totem | jump[\\s_-]?reset | ping[\\s_-]?spoof | axe[\\s_-]?spam"
+        + " | web[\\s_-]?macro | self[\\s_-]?destruct");
+
+    /** Names to look for in Minecraft's memory. */
+    static final String[] MEMORY_NEEDLES;
+    static {
+        List<String> l = new ArrayList<>(Arrays.asList(STRONG));
+        l.addAll(Arrays.asList("meteordevelopment", "wurstclient", "net/ccbluex", "aristois", "rusherhack", "thunderhack", "impactclient", "doomsdayclient"));
+        MEMORY_NEEDLES = l.toArray(new String[0]);
+    }
+
+    /** Legit client files that contain common words like "Velocity" for their own features. */
+    record KnownClient(String name, Pattern file, Pattern folder) {}
+    static final KnownClient[] KNOWN_CLIENTS = {
+        new KnownClient("Dawn client", Pattern.compile("^dawn-client.*\\.jar$"), Pattern.compile("[\\\\/]\\.(dawn|feather)[\\\\/]"))
+    };
+
+    static String knownClient(String fileName, String fullPath) {
+        for (KnownClient k : KNOWN_CLIENTS) {
+            if (k.file().matcher(fileName).find() && k.folder().matcher(fullPath).find()) return k.name();
+        }
+        return null;
+    }
+
+    static final int MAX_ENTRY_BYTES = 8 * 1024 * 1024;
+
+    /** One place in a jar where cheat names were found. */
+    record Hit(String where, List<String> strings, boolean strong) {}
+
+    /** Searches a jar for cheat strings: entry names, then file contents, then nested jars. */
+    static void searchJar(byte[] jar, String label, List<Hit> hits, int level) {
+        TreeSet<String> found = new TreeSet<>();
+        TreeSet<String> weak = new TreeSet<>();
+        try (ZipInputStream zin = new ZipInputStream(new ByteArrayInputStream(jar))) {
+            ZipEntry e;
+            while ((e = zin.getNextEntry()) != null) {
+                if (e.isDirectory()) continue;
+                String name = e.getName();
+                Matcher m = STRONG_RE.matcher(name);
+                while (m.find()) found.add(m.group());
+                Matcher wm = WEAK_NAME_RE.matcher(name);
+                if (wm.find()) weak.add(wm.group(1));
+
+                String lower = name.toLowerCase();
+                boolean nested = lower.endsWith(".jar") && level < 3;
+                boolean text = lower.endsWith(".class") || lower.endsWith(".json") || lower.endsWith(".toml") || lower.endsWith(".mf");
+                if (!nested && !text) continue;
+                byte[] data = readLimited(zin);
+                if (data == null || data.length == 0) continue;
+                if (nested) {
+                    searchJar(data, label + " -> " + name.substring(name.lastIndexOf('/') + 1), hits, level + 1);
+                    continue;
+                }
+                String s = new String(data, StandardCharsets.ISO_8859_1);
+                Matcher sm = STRONG_RE.matcher(s);
+                while (sm.find()) found.add(sm.group());
+                if (lower.endsWith(".class")) {
+                    Matcher cm = WEAK_CONST_RE.matcher(s);
+                    while (cm.find()) weak.add(cm.group().substring(3));
+                }
+            }
+        } catch (IOException | RuntimeException ignored) {
+            // not a readable zip: nothing to search
+        }
+        if (!found.isEmpty() || !weak.isEmpty()) {
+            TreeSet<String> all = new TreeSet<>(found);
+            all.addAll(weak);
+            hits.add(new Hit(label, new ArrayList<>(all), !found.isEmpty()));
+        }
+    }
+
+    /** Reads the current zip entry, or null when it is bigger than the limit. */
+    private static byte[] readLimited(InputStream in) throws IOException {
+        ByteArrayOutputStream bo = new ByteArrayOutputStream();
+        byte[] buf = new byte[16384];
+        int n;
+        while ((n = in.read(buf)) > 0) {
+            bo.write(buf, 0, n);
+            if (bo.size() > MAX_ENTRY_BYTES) return null;
+        }
+        return bo.toByteArray();
+    }
+
+    /** Class names only (no unpacking of contents), for jars of mods that are already recognised. */
+    static List<String> cheatClasses(byte[] jar) {
+        TreeSet<String> found = new TreeSet<>();
+        try (ZipInputStream zin = new ZipInputStream(new ByteArrayInputStream(jar))) {
+            ZipEntry e;
+            while ((e = zin.getNextEntry()) != null) {
+                String n = e.getName();
+                if (!n.endsWith(".class")) continue;
+                String leaf = n.substring(n.lastIndexOf('/') + 1, n.length() - 6);
+                int d = leaf.indexOf('$');
+                if (d >= 0) leaf = leaf.substring(0, d);
+                if (CLASS_RE.matcher(leaf).matches()) found.add(leaf);
+            }
+        } catch (IOException | RuntimeException ignored) {
+        }
+        return new ArrayList<>(found);
+    }
+
+    /** CurseForge fingerprint: MurmurHash2 (seed 1) of the file with tab, LF, CR and space bytes removed. */
+    static long curseForgeFingerprint(byte[] raw) {
+        byte[] data = new byte[raw.length];
+        int len = 0;
+        for (byte b : raw) if (b != 9 && b != 10 && b != 13 && b != 32) data[len++] = b;
+        final int m = 0x5bd1e995;
+        int h = 1 ^ len;
+        int i = 0;
+        while (len - i >= 4) {
+            int k = (data[i] & 0xff) | (data[i + 1] & 0xff) << 8 | (data[i + 2] & 0xff) << 16 | (data[i + 3] & 0xff) << 24;
+            k *= m;
+            k ^= k >>> 24;
+            k *= m;
+            h = h * m ^ k;
+            i += 4;
+        }
+        int rest = len - i;
+        if (rest >= 3) h ^= (data[i + 2] & 0xff) << 16;
+        if (rest >= 2) h ^= (data[i + 1] & 0xff) << 8;
+        if (rest >= 1) { h ^= data[i] & 0xff; h *= m; }
+        h ^= h >>> 13;
+        h *= m;
+        h ^= h >>> 15;
+        return h & 0xffffffffL;
+    }
+}
diff --git a/windows/src/main/java/com/napatc1/modanzer/Common.java b/windows/src/main/java/com/napatc1/modanzer/Common.java
new file mode 100644
index 0000000..9820875
--- /dev/null
+++ b/windows/src/main/java/com/napatc1/modanzer/Common.java
@@ -0,0 +1,145 @@
+package com.napatc1.modanzer;
+
+import java.io.File;
+import java.nio.file.Path;
+import java.time.LocalTime;
+import java.time.format.DateTimeFormatter;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+/** Shared bits: paths, alerts, launcher names, tool names. */
+final class Common {
+    private Common() {}
+
+    /** One finding of the injection or system check. Level is Red or Yellow. */
+    record Alert(String time, String level, String text) {
+        Map<String, Object> toMap() {
+            Map<String, Object> m = new LinkedHashMap<>();
+            m.put("Time", time);
+            m.put("Level", level);
+            m.put("Text", text);
+            return m;
+        }
+    }
+
+    static Alert alert(Out out, String level, String text, List<Alert> into) {
+        String stamp = LocalTime.now().format(DateTimeFormatter.ofPattern("HH:mm:ss"));
+        out.progress("");
+        out.text(Out.C.DIM, "  [" + stamp + "] ");
+        out.line(level.equals("Red") ? Out.C.RED : level.equals("Yellow") ? Out.C.YELLOW : Out.C.GRAY, text);
+        Alert a = new Alert(stamp, level, text);
+        if (into != null) into.add(a);
+        return a;
+    }
+
+    static List<Map<String, Object>> alertMaps(List<Alert> alerts) {
+        List<Map<String, Object>> l = new ArrayList<>();
+        for (Alert a : alerts) l.add(a.toMap());
+        return l;
+    }
+
+    /** Replaces the user's folders with %APPDATA%, %LOCALAPPDATA% and ~ so reports don't show them. */
+    static String shortPath(String p) {
+        if (p == null) return "";
+        String[][] pairs = { { Sys.appData(), "%APPDATA%" }, { Sys.localAppData(), "%LOCALAPPDATA%" }, { Sys.userHome(), "~" } };
+        for (String[] pair : pairs) {
+            if (!pair[0].isEmpty() && p.regionMatches(true, 0, pair[0], 0, pair[0].length())) return pair[1] + p.substring(pair[0].length());
+        }
+        return p;
+    }
+
+    static String uptime(java.time.Duration t) {
+        return String.format("%dh %dm %ds", t.toHours(), t.toMinutesPart(), t.toSecondsPart());
+    }
+
+    private static final Pattern DOT_FOLDER = Pattern.compile("\\\\\\.([^\\\\]+)\\\\");
+
+    static String launcherName(String path) {
+        String l = path.replace('/', '\\').toLowerCase(Locale.ROOT);
+        if (l.matches("(?s).*(curseforge|\\\\twitch\\\\).*")) return "CurseForge";
+        if (l.matches("(?s).*(modrinthapp|theseus).*")) return "Modrinth";
+        if (l.contains("prismlauncher")) return "Prism";
+        if (l.contains("polymc")) return "PolyMC";
+        if (l.contains("multimc")) return "MultiMC";
+        if (l.contains("atlauncher")) return "ATLauncher";
+        if (l.contains("gdlauncher")) return "GDLauncher";
+        if (l.contains("\\.technic\\")) return "Technic";
+        if (l.contains("\\.dawn\\") || l.contains("\\.feather\\")) return "Dawn";
+        if (l.contains("\\.lunarclient\\")) return "Lunar";
+        if (l.contains("fastclient")) return "Fast Client";
+        if (l.contains("\\.tlauncher\\")) return "TLauncher";
+        if (l.contains("\\.minecraft\\")) return "Minecraft";
+        Matcher m = DOT_FOLDER.matcher(l);
+        if (m.find()) return "." + m.group(1);
+        return "Custom";
+    }
+
+    static boolean underPath(String file, List<String> roots) {
+        String f = file.replace('/', '\\').toLowerCase(Locale.ROOT);
+        for (String r : roots) {
+            if (r == null || r.isEmpty()) continue;
+            String rr = r.replace('/', '\\').toLowerCase(Locale.ROOT);
+            while (rr.endsWith("\\")) rr = rr.substring(0, rr.length() - 1);
+            if (f.startsWith(rr)) return true;
+        }
+        return false;
+    }
+
+    /** Folders that normal programs aren't run or loaded from. */
+    static List<String> userDropFolders() {
+        String h = Sys.userHome();
+        List<String> l = new ArrayList<>();
+        for (String s : new String[] { h + "\\Downloads", h + "\\Desktop", h + "\\Documents", Sys.env("TEMP"), Sys.localAppData() + "\\Temp",
+                h + "\\Videos", h + "\\Music", h + "\\Pictures" }) {
+            if (s != null && !s.startsWith("\\") && !l.contains(s)) l.add(s);
+        }
+        return l;
+    }
+
+    // Program names that point to cheating tools (red) or are worth a look (yellow).
+    private static final Pattern TOOL_RED = Pattern.compile(
+        "cheat\\s?engine|process\\s?hacker|system\\s?informer|x64dbg|x32dbg|ollydbg|dnspy|recaf|jd-gui|bytecode\\s?viewer|extreme\\s?injector|xenos|injector|dll\\s?inject|kdmapper|manual\\s?map|vape[ .\\-_]?(lite|v4|client)?\\.exe|doomsday");
+    private static final Pattern TOOL_YELLOW = Pattern.compile(
+        "autohotkey|\\.ahk$|tinytask|macro|procexp|process\\s?explorer|ghidra|ida64|ida\\.exe|wireshark|fiddler|cheat");
+
+    static String toolLevel(String name) {
+        if (name == null || name.isEmpty()) return null;
+        String n = name.toLowerCase(Locale.ROOT);
+        if (TOOL_RED.matcher(n).find()) return "Red";
+        if (TOOL_YELLOW.matcher(n).find()) return "Yellow";
+        return null;
+    }
+
+    static Path path(String p) { return new File(p).toPath(); }
+
+    private static final Map<String, String> SIGNERS = new java.util.HashMap<>();
+
+    /** Who signed a file (Windows only), or null when it is not validly signed. */
+    static synchronized String signer(String file) {
+        if (SIGNERS.containsKey(file)) return SIGNERS.get(file);
+        String r = null;
+        if (Sys.WINDOWS) {
+            String out = Sys.powershell(30, "$s = Get-AuthenticodeSignature -LiteralPath '" + file.replace("'", "''")
+                + "' -ErrorAction SilentlyContinue; if ($s -and $s.Status -eq 'Valid' -and $s.SignerCertificate) { $s.SignerCertificate.GetNameInfo('SimpleName', $false) }");
+            if (out != null && !out.isBlank()) r = out.trim();
+        }
+        SIGNERS.put(file, r);
+        return r;
+    }
+
+    static boolean isAdmin() {
+        if (!Sys.WINDOWS) return false;
+        try {
+            Process p = new ProcessBuilder("net", "session").redirectErrorStream(true).start();
+            p.getInputStream().readAllBytes();
+            return p.waitFor() == 0;
+        } catch (Exception e) {
+            return false;
+        }
+    }
+}
