+            { "(Invoke-WebRequest|\\biwr\\b|\\bcurl\\b|\\bwget\\b|Start-BitsTransfer|DownloadFile|Invoke-RestMethod|\\birm\\b).*\\.(jar|dll|exe)\\b", "Yellow", "downloaded a program or mod from the command line" } };
